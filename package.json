{
  "name": "openupm-cli",
  "version": "4.5.2",
  "preferGlobal": true,
  "description": "openupm command line interface",
  "engines": {
    "node": "^20.17.0 || >=22.9.0"
  },
  "scripts": {
    "test:e2e": "jest --testMatch \"**/e2e/**/*.test.ts\" --runInBand",
    "test:integration": "jest --testMatch \"**/integration/**/*.test.ts\" --runInBand",
    "test:unit": "jest --testMatch \"**/unit/**/*.test.ts\"",
    "clean": "node -e \"require('fs').rmSync('lib', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:watch": "tsc -w -p tsconfig.build.json"
  },
  "bin": {
    "openupm": "lib/index.js",
    "openupm-cli": "lib/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/openupm/openupm-cli.git"
  },
  "keywords": [
    "openupm",
    "cli"
  ],
  "author": "Favo Yang",
  "license": "BSD-3-Clause",
  "bugs": {
    "url": "https://github.com/openupm/openupm-cli/issues"
  },
  "homepage": "https://openupm.com",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@npm/types": "^1.0.2",
    "@types/cli-table": "^0.3.4",
    "@types/fs-extra": "^11.0.3",
    "@types/jest": "^30.0.0",
    "@types/libnpmsearch": "^2.0.4",
    "@types/node": "^20.19.43",
    "@types/pkginfo": "^0.4.1",
    "@types/promptly": "^3.0.3",
    "@types/request": "^2.48.12",
    "@types/semver": "^7.8.0",
    "@types/update-notifier": "^5.1.0",
    "cross-env": "^7.0.3",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^62.9.0",
    "fast-check": "^3.16.0",
    "jest": "^30.5.2",
    "nock": "^13.5.5",
    "prettier": "^2.8.8",
    "ts-jest": "^29.4.15",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.72.1"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^9.5.0",
    "@iarna/toml": "^2.2.5",
    "chalk": "^4.1.2",
    "cli-table": "^0.3.11",
    "commander": "^9.5.0",
    "fs-extra": "^10.1.0",
    "libnpmsearch": "^9.0.1",
    "mkdirp": "^3.0.1",
    "node-fetch": "^2.7.0",
    "npm-profile": "^12.0.2",
    "npm-registry-fetch": "^19.1.1",
    "pkginfo": "^0.4.1",
    "promptly": "^3.2.0",
    "semver": "^7.5.4",
    "ts-custom-error": "^3.3.1",
    "ts-results-es": "^4.1.0",
    "update-notifier": "^5.1.0",
    "yaml": "^2.2.2",
    "zod": "^3.23.8"
  },
  "overrides": {
    "test-exclude": "^8.0.0"
  }
}
